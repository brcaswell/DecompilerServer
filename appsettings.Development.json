{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "DecompilerServer": "Trace",
      "DecompilerServer.Services.McpLoggingService": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "DecompilerServer": "Trace"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext:l}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File", 
        "Args": {
          "restrictedToMinimumLevel": "Trace"
        }
      }
    ]
  },
  "McpLogging": {
    "LogToolCalls": true,
    "LogAssemblyOperations": true,
    "LogDecompilation": true,
    "LogSearchOperations": true,
    "DetailedErrors": true,
    "LogPerformanceMetrics": true,
    "SlowOperationThresholdMs": 500,
    "EnableInspector": true,
    "UseCorrelationIds": true
  },
  "SeqLogging": {
    "MinimumLevel": "Debug"
  }
}