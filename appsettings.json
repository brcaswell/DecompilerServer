{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "DecompilerServer": "Debug",
      "ModelContextProtocol": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File", 
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "DecompilerServer": "Debug",
        "DecompilerServer.Services.McpLoggingService": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext:l}: {Message:lj}{NewLine}{Exception}",
          "standardErrorFromLevel": "Verbose"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/decompiler-server-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://decompiler-seq:80",
          "restrictedToMinimumLevel": "Information",
          "batchPostingLimit": 1,
          "period": "00:00:00.5",
          "queueSizeLimit": 1000
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName", 
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "DecompilerServer",
      "Environment": "Development"
    }
  },
  "McpLogging": {
    "LogToolCalls": true,
    "LogAssemblyOperations": true,
    "LogDecompilation": false,
    "LogSearchOperations": true,
    "DetailedErrors": true,
    "LogPerformanceMetrics": true,
    "SlowOperationThresholdMs": 1000,
    "EnableInspector": true,
    "UseCorrelationIds": true
  },
  "SeqLogging": {
    "ServerUrl": "http://localhost:5341",
    "ApiKey": "",
    "MinimumLevel": "Information",
    "BatchPostingLimit": 50,
    "Period": "00:00:02"
  },
  "McpInspector": {
    "Enabled": true,
    "Port": 3000,
    "LogRequests": true,
    "LogResponses": true,
    "LogErrors": true,
    "MaxMessageSize": 10485760
  }
}